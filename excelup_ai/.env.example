# SkillSetu environment — copy to .env and fill in.
# The app MUST boot and fully function with empty LLM keys (deterministic fallbacks).
DATABASE_URL=
SECRET_KEY=change-me-to-a-long-random-string
GEMINI_API_KEY=
GROQ_API_KEY=
FRONTEND_ORIGINS=http://localhost:3000
# auto = try local MiniLM, fall back to deterministic hashing embedder if unavailable
EMBEDDINGS_PROVIDER=auto
